# ===== Wajib diisi =====
# Kunci penanda token login admin. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Akun admin pertama (dibuat otomatis saat API pertama kali jalan bila belum ada admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# LLM: isi kunci Groq dan/atau Gemini. Bila keduanya terisi, model dipilih lewat toggle "Model LLM" di panel admin.
# Bila LLM_PROVIDER kosong, Groq dipakai saat GROQ_API_KEY terisi, selain itu Gemini.
# Groq: ambil gratis di https://console.groq.com/keys
GROQ_API_KEY=
# Gemini (alternatif): ambil gratis di https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== Bot Telegram =====
# Buat bot lewat @BotFather, salin token-nya ke sini.
TELEGRAM_TOKEN=
# Kunci bersama antara bot dan API (isi bebas, acak, panjang). Disarankan selalu diisi.
BOT_API_KEY=
# Alamat API yang dipanggil bot.
API_BASE_URL=http://127.0.0.1:8001
# ID Telegram admin yang boleh kirim file ke bot (pisahkan koma). Cari ID lewat perintah /id di bot.
ADMIN_TELEGRAM_IDS=

# ===== Opsional (nilai di bawah adalah default) =====
# groq | gemini | extractive (extractive = tanpa LLM, mengutip potongan dokumen; untuk tes offline)
# LLM_PROVIDER=groq   # pilihan awal saat server mulai; pilihan dari panel admin menimpanya
# Model Groq. Daftar model: https://console.groq.com/docs/models
GROQ_MODEL=llama-3.3-70b-versatile
# Cek nama model terbaru di Google AI Studio bila error "model not found".
GEMINI_MODEL=gemini-3.6-flash

# sentence-transformers | hashing (hashing = hanya untuk tes, kualitas rendah)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Prefix query/passage diatur otomatis untuk model e5. Isi hanya bila ingin menimpa.
# EMBEDDING_QUERY_PREFIX=
# EMBEDDING_PASSAGE_PREFIX=

TOP_K=5
SEMANTIC_WEIGHT=0.6
# Ambang skor hybrid. Di bawah ini bot menjawab "tidak ditemukan" tanpa memanggil LLM.
# Kalibrasi dengan: python -m eval.run_eval
SCORE_THRESHOLD=0.5
CHUNK_MAX_CHARS=1800
CHUNK_OVERLAP_CHARS=200
CACHE_TTL_HOURS=24
MAX_UPLOAD_MB=25
BOT_COOLDOWN_SECONDS=3
# Sesi bot berakhir bila pengguna diam sekian detik; setelah itu harus /start lagi. 0 = tanpa batas waktu.
SESSION_TIMEOUT_SECONDS=180
# Zona waktu untuk pertanyaan "hari ini", "besok", "sekarang" pada jadwal.
TIMEZONE=Asia/Jakarta
# Log pertanyaan dihapus otomatis setelah sekian hari (0 = simpan selamanya).
LOG_RETENTION_DAYS=180
# Muat model embedding saat API start supaya pertanyaan pertama tidak lambat.
WARMUP=true

# ===== OCR (PDF scan dan gambar) =====
# Butuh Tesseract terpasang di sistem. Cek dengan: python -m scripts.doctor
OCR_ENABLED=true
# Bahasa Tesseract. 'ind' perlu paket bahasa Indonesia (lihat README).
OCR_LANGUAGES=ind+eng
OCR_MAX_PAGES=60
OCR_DPI=200
# DATA_DIR=./data
# CORS_ORIGINS=http://localhost:5173
